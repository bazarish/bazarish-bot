#!/bin/sh
# Bazarish project (c) 2026
# The config and the state are the operator's: made once when missing, never written over.
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd bazarish >/dev/null; then
        adduser --system --group --home /var/lib/bazarish --no-create-home bazarish
    fi
    if [ ! -d /etc/bazarish ]; then
        install -d -o root -g bazarish -m 0770 /etc/bazarish
    fi
    if [ ! -e /etc/bazarish/bot.json ]; then
        install -o bazarish -g bazarish -m 0600 /usr/share/bazarish-bot/bot.json \
            /etc/bazarish/bot.json
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable bazarish-bot.service >/dev/null
        systemctl restart bazarish-bot.service
    fi
fi
