[Unit]
Description=Bazarish bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bazarish
Group=bazarish
ExecStart=/usr/lib/bazarish-bot/bazarish-bot --config /etc/bazarish/bot.json
Restart=on-failure
RestartSec=5

# The daemon writes its state and, once, the operator it was claimed by into its config.
StateDirectory=bazarish
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/bazarish /etc/bazarish

[Install]
WantedBy=multi-user.target
