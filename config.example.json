{
  // Where this daemon keeps its account, its mailbox and its I2P state.
  "state": "/var/lib/bazarish/daemon",

  // The REST API the operator's automation calls. The token is the whole of the
  // authentication: whoever has it has the account, so keep the listener on
  // loopback unless something else terminates TLS in front of it.
  "api": {
    "listen": {"host": "127.0.0.1", "port": 8440},
    "token": "change-me"
  },

  "i2p": {
    // Talk to a router that is already running, on its SAM port. Remove this
    // block and the daemon runs a router of its own instead. The port must be
    // on loopback either way: a SAM session hands the router a private key.
    "sam": {"host": "127.0.0.1", "port": 7656},
    // Tunnel length: minimal, middle or max.
    "privacy": "middle"
  },

  "logLevel": "info"
}
